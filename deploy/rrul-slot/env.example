# rrul-slot site config — copy to ~/.config/wanctl-rrul/env and chmod 0600.
# KEY=VALUE lines only; the file is parsed, never sourced. Environment variables of the same name take precedence.
# Keep real addresses out of the repository: this example uses documentation placeholders.

# flent endpoint: runs netserver (forking) and an irtt server, and answers ICMP. Required.
RRUL_SLOT_HOST=192.0.2.10

# Endpoints known to bottleneck below the line rate; refused (space-separated).
#RRUL_SLOT_UNSUITABLE_HOSTS="192.0.2.20"

# Idle RTT to the endpoint in ms, the reference for the sustained-breach rule.
#RRUL_SLOT_IDLE_MS=22

# Raw run directories, rrul.csv and the run lock. Default: ~/.local/share/wanctl-rrul
#RRUL_SLOT_DATA_DIR=/home/USER/.local/share/wanctl-rrul

# ssh alias of the shaper host: read max_dl_shaper_rate_kbps (read-only grep) into the CSV. Unset: column empty.
#RRUL_SLOT_SHAPER_SSH=shaper-alias

# Read-only Prometheus query command ("q EXPR TIME" / "range EXPR START END STEP", printing .data.result JSON).
# A bare name is looked up in PATH; the systemd unit sets PATH to ~/.local/bin plus the system directories. Use an
# absolute path for a command elsewhere. A command that cannot be found stops the run before any load (exit 2,
# naming RRUL_SLOT_PROM_CMD).
#RRUL_SLOT_PROM_CMD=prom-ro

# flent executable, if not "flent" on PATH.
#RRUL_SLOT_FLENT_CMD=flent
