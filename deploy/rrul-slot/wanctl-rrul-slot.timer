# systemd --user timer for wanctl-rrul-slot.service — PROPOSAL, do not enable until the schedule is confirmed.
# Day slots start at :05:30 so a single run (deadline 300 s + 30 s kill grace, ends by :11:00) sits between the
# endpoint's sysstat sa1 runs at :05 and :15, outside 03:00-03:59 Central. The evening slots are cap sweeps
# (RRUL_SLOT_SWEEP_SLOTS must list the same times): about 6 min each, at most 25.5 min. They cross sa1 runs, and 21:05
# and 22:35 fall in the endpoint's 21:00-22:59 window (Sunday e2scrub at 03:10/03:30 if that host runs UTC); accepted
# for the evening evidence, see docs/RRUL_SLOT.md.
[Unit]
Description=Scheduled wanctl RRUL time-of-day measurement (proposal)

[Timer]
OnCalendar=*-*-* 06,10,14,17:05:30 America/Chicago
OnCalendar=*-*-* 19:35:30 America/Chicago
OnCalendar=*-*-* 21:05:30 America/Chicago
OnCalendar=*-*-* 22:35:30 America/Chicago
AccuracySec=1s
RandomizedDelaySec=0
# A missed run is skipped, not caught up: a late start could straddle sa1 or land at a busy time.
Persistent=false

[Install]
WantedBy=timers.target
