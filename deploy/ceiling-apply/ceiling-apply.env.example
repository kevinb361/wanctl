# /etc/wanctl/ceiling-apply.env for scripts/wanctl_ceiling_apply.py (installed as /usr/local/sbin/wanctl-ceiling-apply).
# KEY=VALUE lines, parsed, never sourced. Unknown keys are an error. Shown values are the built-in defaults.
# Read docs/CEILING_APPLY.md, including its enable prerequisites, before changing CEILING_APPLY_ENABLED.

# 1 enables `tick`. Anything else (or no file at all): `tick` does nothing, not even read the table.
CEILING_APPLY_ENABLED=0

# Where the delivered shadow-YYYY-MM-DD.json tables and analyzer-status.json are found (delivery is not provided here).
#CEILING_APPLY_TABLE_DIR=/var/lib/wanctl/ceiling-apply/shadow
# State, events.jsonl.
#CEILING_APPLY_STATE_DIR=/var/lib/wanctl/ceiling-apply
# Off switch: while this file exists the ceiling is held at 780 Mbit.
#CEILING_APPLY_OFF_FILE=/etc/wanctl/ceiling-apply.off

#CEILING_APPLY_CONFIG=/etc/cake-autorate/config.spectrum.sh
#CEILING_APPLY_UNIT=cake-autorate-spectrum.service
#CEILING_APPLY_BRIDGE=cake-autorate-spectrum-state-bridge.service
#CEILING_APPLY_BYPASS_CMD=/usr/local/sbin/silicom-bypass
#CEILING_APPLY_BYPASS_PAIR=spec-modem

# Shared with wanctl-sweep-cap; must match the installed helper.
#CEILING_APPLY_LOCK=/run/wanctl-ceiling-apply.lock
#CEILING_APPLY_SWEEP_LOCK=/run/wanctl-sweep-cap.lock
#CEILING_APPLY_SWEEP_MARKER=/run/wanctl-sweep-cap.hold
#CEILING_APPLY_SWEEP_TIMER=wanctl-sweep-cap-autorestore.timer
