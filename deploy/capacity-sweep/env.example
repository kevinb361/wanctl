# capacity-sweep site config — copy to ~/.config/wanctl-sweep/env and chmod 0600.
# KEY=VALUE lines only; the file is parsed, never sourced. Environment variables of the same name take precedence.
# Keep real addresses out of the repository: this example uses documentation placeholders.

# iperf3 server (forking) and fping target. Required.
CAPACITY_SWEEP_HOST=192.0.2.10

# Endpoints known to bottleneck below the line rate; refused as capacity endpoints (space-separated).
#CAPACITY_SWEEP_UNSUITABLE_HOSTS="192.0.2.20"

# Idle RTT to the endpoint in ms, the reference for the knee and breach rules.
#CAPACITY_SWEEP_IDLE_MS=22

# Raw files, sweeps.csv and the run lock. Default: ~/.local/share/wanctl-sweeps
#CAPACITY_SWEEP_DATA_DIR=/home/USER/.local/share/wanctl-sweeps

# node_exporter textfile output (one file, replaced atomically). Leave unset until a textfile collector reads it.
#CAPACITY_SWEEP_TEXTFILE=/var/lib/node-exporter-textfile/wanctl_capacity_sweep.prom

# ssh alias of the shaper host: read max_dl_shaper_rate_kbps (read-only grep) into the CSV. Unset: column empty.
#CAPACITY_SWEEP_SHAPER_SSH=shaper-alias

# Read-only Prometheus query command ("q EXPR TIME" / "range EXPR START END STEP", printing .data.result JSON).
#CAPACITY_SWEEP_PROM_CMD=prom-ro
