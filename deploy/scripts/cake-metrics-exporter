#!/usr/bin/env python3
"""cake-autorate Prometheus exporter (read-only).

Reads the cake-autorate state-bridge JSON snapshots and exposes them as
Prometheus metrics. It only reads /var/lib/wanctl/<wan>_state.json — it never
touches tc/cake/nftables or the shaper, so a failure here cannot affect WAN
shaping (it just stops serving metrics).
"""

from __future__ import annotations

import json
import math
import os
import time
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

WANS = os.environ.get("CAKE_EXPORTER_WANS", "spectrum,att").split(",")
STATE_DIR = Path(os.environ.get("CAKE_EXPORTER_STATE_DIR", "/var/lib/wanctl"))
BIND = os.environ.get("CAKE_EXPORTER_BIND", "127.0.0.1")
PORT = int(os.environ.get("CAKE_EXPORTER_PORT", "9102"))

CONGESTION = {"GREEN": 0, "SOFT_RED": 1, "RED": 2}


def _esc(v: str) -> str:
    return v.replace("\\", "\\\\").replace('"', '\\"')


def _number(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return value if math.isfinite(value) and value >= 0 else None


def _age_seconds(timestamp: str):
    try:
        return max(0.0, time.time() - datetime.fromisoformat(timestamp).timestamp())
    except (TypeError, ValueError):
        return None


def render() -> str:  # noqa: C901 - direct translation of the stable exporter contract
    out: list[str] = []
    seen: set[str] = set()

    def emit(name: str, value, labels: dict[str, str], mtype: str, help_: str):
        if name not in seen:
            out.append(f"# HELP {name} {help_}")
            out.append(f"# TYPE {name} {mtype}")
            seen.add(name)
        lbl = ",".join(f'{k}="{_esc(v)}"' for k, v in labels.items())
        out.append(f"{name}{{{lbl}}} {value}")

    for wan in WANS:
        wan = wan.strip()
        if not wan:
            continue
        path = STATE_DIR / f"{wan}_state.json"
        try:
            data = json.loads(path.read_text())
            if not isinstance(data, dict):
                raise TypeError("state snapshot is not an object")
        except (OSError, TypeError, ValueError, json.JSONDecodeError):
            emit("cake_state_up", 0, {"wan": wan}, "gauge", "1 if state JSON read+parsed ok")
            continue
        emit("cake_state_up", 1, {"wan": wan}, "gauge", "1 if state JSON read+parsed ok")

        for direction in ("download", "upload"):
            d = data.get(direction, {})
            if "current_rate" in d:
                emit(
                    "cake_shaped_rate_bps",
                    d["current_rate"],
                    {"wan": wan, "direction": direction},
                    "gauge",
                    "Current CAKE-applied shaped rate (bits/s)",
                )
            for streak in ("green_streak", "soft_red_streak", "red_streak"):
                if streak in d:
                    emit(
                        f"cake_{streak}",
                        d[streak],
                        {"wan": wan, "direction": direction},
                        "gauge",
                        f"cake-autorate {streak} count",
                    )

        cong = data.get("congestion", {})
        for direction, key in (("download", "dl_state"), ("upload", "ul_state")):
            st = cong.get(key)
            if st is not None:
                emit(
                    "cake_congestion_state",
                    CONGESTION.get(st, -1),
                    {"wan": wan, "direction": direction},
                    "gauge",
                    "Congestion state 0=GREEN 1=SOFT_RED 2=RED -1=unknown",
                )

        ewma = data.get("ewma", {})
        base = ewma.get("baseline_rtt")
        load = ewma.get("load_rtt")
        if base is not None:
            emit(
                "cake_baseline_rtt_ms",
                base,
                {"wan": wan},
                "gauge",
                "EWMA baseline RTT (ms)",
            )
        if load is not None:
            emit("cake_load_rtt_ms", load, {"wan": wan}, "gauge", "RTT under load (ms)")
        measurement = data.get("measurement") or {}
        probe_up = bool(measurement.get("backend")) and _number(load) is not None
        emit(
            "cake_probe_up",
            int(probe_up),
            {"wan": wan},
            "gauge",
            "1 if the bridge produced a fresh raw RTT probe measurement",
        )
        if probe_up:
            emit(
                "cake_probe_rtt_seconds",
                _number(load) / 1000,
                {"wan": wan},
                "gauge",
                "Latest raw bridge RTT probe measurement in seconds",
            )
        if base is not None and load is not None:
            emit(
                "cake_rtt_delta_ms",
                round(load - base, 4),
                {"wan": wan},
                "gauge",
                "Load RTT minus baseline RTT (ms) — the latency-under-load signal",
            )

        ts = data.get("timestamp")
        age = _age_seconds(ts) if ts else None
        if age is not None:
            emit(
                "cake_state_age_seconds",
                round(age, 2),
                {"wan": wan},
                "gauge",
                "Seconds since the state snapshot was written (freshness)",
            )

        cake_stats = data.get("cake_stats")
        stats_ok = isinstance(cake_stats, dict) and cake_stats.get("collection_ok") is True
        emit(
            "cake_stats_up",
            int(stats_ok),
            {"wan": wan},
            "gauge",
            "1 if both CAKE direction snapshots were collected successfully",
        )
        if not isinstance(cake_stats, dict):
            continue
        stats_age = _age_seconds(cake_stats.get("collected_at"))
        if stats_age is not None:
            emit(
                "cake_stats_age_seconds",
                round(stats_age, 2),
                {"wan": wan},
                "gauge",
                "Seconds since the CAKE qdisc statistics snapshot was collected",
            )
        directions = cake_stats.get("directions")
        if not isinstance(directions, dict):
            continue
        for direction in ("download", "upload"):
            snapshot = directions.get(direction)
            if not isinstance(snapshot, dict) or not isinstance(snapshot.get("tins"), list):
                continue
            seen_tins: set[str] = set()
            for tin in snapshot["tins"]:
                if not isinstance(tin, dict):
                    continue
                tin_name = tin.get("name")
                if (
                    tin_name not in {"bulk", "best_effort", "video", "voice"}
                    or tin_name in seen_tins
                ):
                    continue
                seen_tins.add(tin_name)
                labels = {"wan": wan, "direction": direction, "tin": tin_name}
                for metric, key, help_ in (
                    ("cake_tin_sent_packets_total", "sent_packets", "Raw CAKE packets sent by tin"),
                    ("cake_tin_sent_bytes_total", "sent_bytes", "Raw CAKE bytes sent by tin"),
                    ("cake_tin_dropped_packets_total", "drops", "Raw CAKE packets dropped by tin"),
                    (
                        "cake_tin_ecn_marked_packets_total",
                        "ecn_mark",
                        "Raw CAKE packets ECN-marked by tin",
                    ),
                    (
                        "cake_tin_resets_total",
                        "counter_resets_total",
                        "Detected decreases in raw CAKE counters by tin",
                    ),
                ):
                    value = _number(tin.get(key))
                    if value is not None:
                        emit(metric, value, labels, "counter", help_)
                backlog = _number(tin.get("backlog_bytes"))
                if backlog is not None:
                    emit(
                        "cake_tin_backlog_bytes",
                        backlog,
                        labels,
                        "gauge",
                        "Current CAKE tin backlog in bytes",
                    )
                for metric, key, help_ in (
                    (
                        "cake_tin_peak_delay_seconds",
                        "peak_delay_us",
                        "Peak CAKE tin delay in seconds",
                    ),
                    (
                        "cake_tin_average_delay_seconds",
                        "avg_delay_us",
                        "Average CAKE tin delay in seconds",
                    ),
                    (
                        "cake_tin_base_delay_seconds",
                        "base_delay_us",
                        "Base CAKE tin delay in seconds",
                    ),
                ):
                    value = _number(tin.get(key))
                    if value is not None:
                        emit(metric, value / 1_000_000, labels, "gauge", help_)

    return "\n".join(out) + "\n"


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802
        if self.path.rstrip("/") in ("/metrics", ""):
            body = render().encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, *args):  # silence
        pass


if __name__ == "__main__":
    ThreadingHTTPServer((BIND, PORT), Handler).serve_forever()
