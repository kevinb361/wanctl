#!/usr/bin/env python3
from __future__ import annotations

import atexit
import json
import os
import re
import sqlite3
import statistics
import subprocess
import tempfile
import threading
import time
from contextlib import contextmanager
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

WAN_NAME = os.environ.get("WANCTL_EXTERNAL_WAN_NAME", "spectrum")
DL_IF = os.environ.get("WANCTL_EXTERNAL_DL_IF", "spec-router")
UL_IF = os.environ.get("WANCTL_EXTERNAL_UL_IF", "spec-modem")
LOG = Path(
    os.environ.get(
        "CAKE_AUTORATE_BRIDGE_LOG", f"/var/log/cake-autorate/cake-autorate.{WAN_NAME}.log"
    )
)
STATE = Path(os.environ.get("WANCTL_EXTERNAL_STATE_PATH", f"/var/lib/wanctl/{WAN_NAME}_state.json"))
STATE_PARENT = STATE.parent
STATE_PARENT_STRING = str(STATE_PARENT)
STATE_TEMP_PREFIX = f"{WAN_NAME}_state."
METRICS_DB = Path(
    os.environ.get("WANCTL_EXTERNAL_METRICS_DB", f"/var/lib/wanctl/metrics-{WAN_NAME}.db")
)
METRICS_ENABLED = os.environ.get("WANCTL_EXTERNAL_METRICS_ENABLED", "1") not in {
    "0",
    "false",
    "False",
    "no",
}
_METRICS_CONN: sqlite3.Connection | None = None
_METRICS_IDENTITY: tuple[int, int] | None = None


@contextmanager
def open_metrics_db():
    """Commit or roll back a bridge metrics transaction, then close its connection."""
    conn = sqlite3.connect(METRICS_DB, timeout=30)
    try:
        with conn:
            yield conn
    finally:
        conn.close()


DEFAULT_BASELINE_RTT = float(os.environ.get("WANCTL_EXTERNAL_BASELINE_RTT", "22.535852814520855"))
WANCTL_UID = int(os.environ.get("WANCTL_STATE_UID", "988"))
WANCTL_GID = int(os.environ.get("WANCTL_STATE_GID", "988"))
CHOWN_STATE = os.environ.get("WANCTL_STATE_CHOWN", "1") not in {"0", "false", "False", "no"}
ONESHOT = os.environ.get("CAKE_AUTORATE_BRIDGE_ONESHOT", "0") in {"1", "true", "True", "yes"}
POLL_INTERVAL = float(os.environ.get("CAKE_AUTORATE_BRIDGE_POLL_INTERVAL", "1"))
HEALTH_HOST = os.environ.get("CAKE_AUTORATE_BRIDGE_HEALTH_HOST", "127.0.0.1")
HEALTH_PORT = int(os.environ.get("CAKE_AUTORATE_BRIDGE_HEALTH_PORT", "9101"))
MAX_STATE_AGE_SECONDS = float(os.environ.get("CAKE_AUTORATE_BRIDGE_MAX_STATE_AGE", "15"))
RTT_ENABLED = os.environ.get("WANCTL_EXTERNAL_RTT_ENABLED", "1") not in {
    "0",
    "false",
    "False",
    "no",
}
PING_SOURCE_IP = os.environ.get("WANCTL_EXTERNAL_PING_SOURCE_IP", "")
PING_HOSTS = [
    host.strip()
    for host in os.environ.get("WANCTL_EXTERNAL_PING_HOSTS", "").split(",")
    if host.strip()
]
PING_TIMEOUT_MS = int(float(os.environ.get("WANCTL_EXTERNAL_PING_TIMEOUT_MS", "500")))
BASELINE_ALPHA = float(os.environ.get("WANCTL_EXTERNAL_BASELINE_ALPHA", "0.02"))
BASELINE_UPWARD_GUARD_MS = float(os.environ.get("WANCTL_EXTERNAL_BASELINE_UPWARD_GUARD_MS", "5.0"))

LINE_RE = re.compile(r"^(SUMMARY|LOAD); ")

TIN_NAMES = ("bulk", "best_effort", "video", "voice")
TIN_COUNTER_KEYS = ("sent_bytes", "sent_packets", "drops", "ecn_mark")
TIN_GAUGE_KEYS = ("backlog_bytes", "peak_delay_us", "avg_delay_us", "base_delay_us")


def _nonnegative_int(value) -> int:
    if isinstance(value, bool):
        raise TypeError("boolean is not a CAKE statistic")
    parsed = int(value)
    if parsed < 0:
        raise ValueError("negative CAKE statistic")
    return parsed


def _snapshot_from_cake(dev: str, cake: dict) -> tuple[dict | None, str | None]:
    try:
        raw_tins = cake.get("tins")
        if not isinstance(raw_tins, list) or len(raw_tins) != len(TIN_NAMES):
            return None, "invalid_tins"
        tins = []
        for name, raw_tin in zip(TIN_NAMES, raw_tins, strict=True):
            if not isinstance(raw_tin, dict):
                return None, "invalid_tins"
            tin = {"name": name}
            for key in (*TIN_COUNTER_KEYS, *TIN_GAUGE_KEYS):
                tin[key] = _nonnegative_int(raw_tin.get(key, 0))
            tin["counter_reset"] = False
            tin["counter_resets_total"] = 0
            tins.append(tin)
        options = cake.get("options") if isinstance(cake.get("options"), dict) else {}
        bandwidth_bytes = options.get("bandwidth")
        rate_bps = _nonnegative_int(bandwidth_bytes) * 8 if bandwidth_bytes is not None else None
        return {
            "interface": dev,
            "rate_bps": rate_bps,
            "packets": _nonnegative_int(cake.get("packets", 0)),
            "bytes": _nonnegative_int(cake.get("bytes", 0)),
            "drops": _nonnegative_int(cake.get("drops", 0)),
            "backlog_bytes": _nonnegative_int(cake.get("backlog", 0)),
            "tins": tins,
        }, None
    except (TypeError, ValueError):
        return None, "malformed_json"


def qdisc_snapshot(dev: str) -> tuple[dict | None, str | None]:
    """Read one interface's CAKE snapshot with one bounded tc invocation."""
    try:
        result = subprocess.run(
            ["tc", "-j", "-s", "qdisc", "show", "dev", dev],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except OSError:
        return None, "exec_error"
    if result.returncode != 0:
        return None, "tc_error"
    try:
        entries = json.loads(result.stdout)
        if not isinstance(entries, list):
            raise TypeError("qdisc result is not a list")
        cake = next(
            entry for entry in entries if isinstance(entry, dict) and entry.get("kind") == "cake"
        )
    except (StopIteration, TypeError, json.JSONDecodeError):
        return None, "malformed_json"
    return _snapshot_from_cake(dev, cake)


def qdisc_snapshots(devices: tuple[str, ...]) -> dict[str, tuple[dict | None, str | None]]:
    """Read all requested interfaces through one bounded, unscoped tc snapshot."""
    try:
        result = subprocess.run(
            ["tc", "-j", "-s", "qdisc", "show"],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except subprocess.TimeoutExpired:
        return {dev: (None, "timeout") for dev in devices}
    except OSError:
        return {dev: (None, "exec_error") for dev in devices}
    if result.returncode != 0:
        return {dev: (None, "tc_error") for dev in devices}
    try:
        entries = json.loads(result.stdout)
        if not isinstance(entries, list):
            raise TypeError("qdisc result is not a list")
    except (TypeError, json.JSONDecodeError):
        return {dev: (None, "malformed_json") for dev in devices}

    cakes: dict[object, dict] = {}
    for entry in entries:
        if isinstance(entry, dict) and entry.get("kind") == "cake":
            cakes.setdefault(entry.get("dev"), entry)
    return {
        dev: _snapshot_from_cake(dev, cakes[dev])
        if dev in cakes
        else (None, "malformed_json")
        for dev in devices
    }


def mark_counter_resets(current: dict, previous: dict | None) -> None:
    if not previous:
        return
    old_tins = {
        tin.get("name"): tin
        for tin in previous.get("tins", [])
        if isinstance(tin, dict) and isinstance(tin.get("name"), str)
    }
    for tin in current["tins"]:
        old = old_tins.get(tin["name"])
        if old:
            try:
                tin["counter_reset"] = any(
                    tin[key] < _nonnegative_int(old.get(key, 0)) for key in TIN_COUNTER_KEYS
                )
                tin["counter_resets_total"] = _nonnegative_int(
                    old.get("counter_resets_total", 0)
                ) + int(tin["counter_reset"])
            except (TypeError, ValueError):
                tin["counter_reset"] = False


_READ_PREVIOUS_STATE = object()
_PREVIOUS_STATE_CACHE: object = _READ_PREVIOUS_STATE


def previous_state_snapshot() -> object:
    global _PREVIOUS_STATE_CACHE
    if _PREVIOUS_STATE_CACHE is not _READ_PREVIOUS_STATE:
        return _PREVIOUS_STATE_CACHE
    try:
        _PREVIOUS_STATE_CACHE = json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        _PREVIOUS_STATE_CACHE = {}
    return _PREVIOUS_STATE_CACHE


def previous_cake_directions(previous_state: object = _READ_PREVIOUS_STATE) -> dict:
    if previous_state is _READ_PREVIOUS_STATE:
        previous_state = previous_state_snapshot()
    if not isinstance(previous_state, dict):
        return {}
    try:
        directions = (previous_state.get("cake_stats") or {}).get("directions") or {}
        return directions if isinstance(directions, dict) else {}
    except AttributeError:
        return {}


def rates_from_row(kind: str, parts: list[str]) -> tuple[int, int, str, str] | None:
    try:
        if kind == "SUMMARY" and len(parts) >= 13:
            return int(float(parts[11]) * 1000), int(float(parts[12]) * 1000), parts[9], parts[10]
        if kind == "LOAD" and len(parts) >= 8:
            return int(float(parts[6]) * 1000), int(float(parts[7]) * 1000), "dl_idle", "ul_idle"
    except (TypeError, ValueError):
        return None
    return None


_LOG_IDENTITY: tuple[int, int] | None = None
_LOG_OFFSET = 0
_LOG_PARTIAL = b""
_LOG_ANCHOR = b""
_LATEST_PARSED_ROW: tuple[int, int, str, str] | None = None


def _latest_from_lines(lines: list[str]) -> tuple[int, int, str, str] | None:
    for line in reversed(lines):
        match = LINE_RE.match(line)
        if not match:
            continue
        parsed = rates_from_row(match.group(1), [part.strip() for part in line.split(";")])
        if parsed:
            return parsed
    return None


def latest_parsed_row() -> tuple[int, int, str, str] | None:
    """Return the latest summary while reading only bytes appended since the last poll."""
    global _LATEST_PARSED_ROW, _LOG_ANCHOR, _LOG_IDENTITY, _LOG_OFFSET, _LOG_PARTIAL
    try:
        with LOG.open("rb") as f:
            stat = os.fstat(f.fileno())
            identity = (stat.st_dev, stat.st_ino)
            reset = identity != _LOG_IDENTITY or stat.st_size < _LOG_OFFSET
            if not reset and _LOG_ANCHOR:
                f.seek(_LOG_OFFSET - len(_LOG_ANCHOR))
                reset = f.read(len(_LOG_ANCHOR)) != _LOG_ANCHOR
            if reset:
                scan_limit = max(0, stat.st_size - 5_000_000)
                scan_size = min(4_096, stat.st_size - scan_limit)
                data = b""
                parsed = None
                while True:
                    scan_start = max(scan_limit, stat.st_size - scan_size)
                    if scan_start > 0:
                        f.seek(scan_start - 1)
                        starts_at_boundary = f.read(1) in {b"\n", b"\r"}
                    else:
                        f.seek(0)
                        starts_at_boundary = True
                    data = f.read(stat.st_size - scan_start)
                    lines = data.decode("utf-8", "replace").splitlines()
                    if not starts_at_boundary and lines:
                        lines = lines[1:]
                    parsed = _latest_from_lines(lines)
                    if parsed is not None or len(data) >= stat.st_size - scan_limit:
                        break
                    scan_size = min(stat.st_size - scan_limit, scan_size * 4)
                _LOG_IDENTITY = identity
                _LOG_OFFSET = stat.st_size
                _LOG_PARTIAL = b""
                _LOG_ANCHOR = data[-128:]
                _LATEST_PARSED_ROW = parsed
                return _LATEST_PARSED_ROW
            if stat.st_size == _LOG_OFFSET:
                return _LATEST_PARSED_ROW
            f.seek(_LOG_OFFSET)
            appended = f.read(stat.st_size - _LOG_OFFSET)
            data = _LOG_PARTIAL + appended
            _LOG_OFFSET = stat.st_size
            _LOG_ANCHOR = (_LOG_ANCHOR + appended)[-128:]
    except FileNotFoundError:
        return None

    if data.endswith((b"\n", b"\r")):
        complete, _LOG_PARTIAL = data, b""
    else:
        split_at = max(data.rfind(b"\n"), data.rfind(b"\r"))
        if split_at < 0:
            _LOG_PARTIAL = data
            return _LATEST_PARSED_ROW
        complete, _LOG_PARTIAL = data[: split_at + 1], data[split_at + 1 :]
    parsed = _latest_from_lines(complete.decode("utf-8", "replace").splitlines())
    if parsed is not None:
        _LATEST_PARSED_ROW = parsed
    return _LATEST_PARSED_ROW


def old_rtt(previous_state: object = _READ_PREVIOUS_STATE) -> tuple[float, float]:
    if previous_state is _READ_PREVIOUS_STATE:
        previous_state = previous_state_snapshot()
    if not isinstance(previous_state, dict):
        return DEFAULT_BASELINE_RTT, DEFAULT_BASELINE_RTT
    try:
        ewma = previous_state.get("ewma") or {}
        baseline = float(ewma.get("baseline_rtt", DEFAULT_BASELINE_RTT))
        load = float(ewma.get("load_rtt", baseline))
        return baseline, load
    except (AttributeError, TypeError, ValueError):
        return DEFAULT_BASELINE_RTT, DEFAULT_BASELINE_RTT


def parse_fping_rtts(output: str) -> list[float]:
    """Extract RTT samples from fping stdout/stderr."""
    samples: list[float] = []
    for line in output.splitlines():
        if ":" not in line:
            continue
        _, rhs = line.split(":", 1)
        detailed_match = re.search(r",\s*([0-9.]+)\s+ms\b", rhs)
        if detailed_match:
            samples.append(float(detailed_match.group(1)))
            continue
        for token in re.split(r"\s+", rhs.strip()):
            if token in {"-", ""}:
                continue
            try:
                samples.append(float(token.strip(",")))
                break
            except ValueError:
                continue
    return samples


def measure_rtt_ms() -> float | None:
    """Measure median RTT using fping bound to the configured WAN source IP.

    cake-autorate logs OWD deltas but not absolute RTT. The external state
    bridge must measure RTT itself so the wanctl-compatible state file does
    not carry a stale load_rtt forever.
    """
    if not RTT_ENABLED or not PING_SOURCE_IP or not PING_HOSTS:
        return None
    try:
        result = subprocess.run(
            [
                "fping",
                "-C1",
                f"-t{PING_TIMEOUT_MS}",
                "-S",
                PING_SOURCE_IP,
                *PING_HOSTS,
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=max(1.0, (PING_TIMEOUT_MS / 1000.0) * len(PING_HOSTS) + 0.5),
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    samples = parse_fping_rtts(f"{result.stdout}\n{result.stderr}")
    if not samples:
        return None
    return float(statistics.median(samples))


def update_rtt(
    dl_state: str, ul_state: str, previous_state: object = _READ_PREVIOUS_STATE
) -> tuple[float, float, str | None]:
    baseline, previous_load = old_rtt(previous_state)
    measured = measure_rtt_ms()
    if measured is None:
        return baseline, previous_load, None

    load = measured
    if (
        dl_state == "GREEN"
        and ul_state == "GREEN"
        and measured <= baseline + BASELINE_UPWARD_GUARD_MS
    ):
        alpha = max(0.0, min(1.0, BASELINE_ALPHA))
        baseline = (baseline * (1.0 - alpha)) + (measured * alpha)
    elif measured < baseline:
        # Let the baseline recover downward quickly; upward drift is guarded.
        alpha = max(0.05, min(1.0, BASELINE_ALPHA))
        baseline = (baseline * (1.0 - alpha)) + (measured * alpha)

    return baseline, load, "fping"


def write_state(state: dict) -> None:
    global _PREVIOUS_STATE_CACHE
    payload = (json.dumps(state, separators=(",", ":")) + "\n").encode("utf-8")
    try:
        fd, tmp = tempfile.mkstemp(
            prefix=STATE_TEMP_PREFIX, suffix=".tmp", dir=STATE_PARENT_STRING
        )
    except FileNotFoundError:
        STATE_PARENT.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(
            prefix=STATE_TEMP_PREFIX, suffix=".tmp", dir=STATE_PARENT_STRING
        )
    try:
        written = os.write(fd, payload)
        while written < len(payload):
            chunk_size = os.write(fd, payload[written:])
            if chunk_size == 0:
                raise OSError("state payload write made no progress")
            written += chunk_size
    finally:
        os.close(fd)
    if CHOWN_STATE:
        os.chown(tmp, WANCTL_UID, WANCTL_GID)
    os.replace(tmp, STATE)
    _PREVIOUS_STATE_CACHE = state


def ensure_metrics_schema(conn: sqlite3.Connection) -> None:
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS metrics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            wan_name TEXT NOT NULL,
            metric_name TEXT NOT NULL,
            value REAL NOT NULL,
            labels TEXT,
            granularity TEXT DEFAULT 'raw'
        )
        """
    )
    conn.execute("CREATE INDEX IF NOT EXISTS idx_metrics_timestamp ON metrics(timestamp)")
    conn.execute(
        "CREATE INDEX IF NOT EXISTS idx_metrics_wan_metric_time ON metrics(wan_name, metric_name, timestamp)"
    )
    conn.execute(
        "CREATE INDEX IF NOT EXISTS idx_metrics_granularity_time ON metrics(granularity, timestamp)"
    )


def close_metrics_connection() -> None:
    global _METRICS_CONN, _METRICS_IDENTITY
    if _METRICS_CONN is not None:
        _METRICS_CONN.close()
    _METRICS_CONN = None
    _METRICS_IDENTITY = None


def metrics_connection() -> sqlite3.Connection:
    """Return a durable connection, reopening if the database path was replaced."""
    global _METRICS_CONN, _METRICS_IDENTITY
    try:
        stat = METRICS_DB.stat()
        identity = (stat.st_dev, stat.st_ino)
    except FileNotFoundError:
        identity = None
    if _METRICS_CONN is not None and identity == _METRICS_IDENTITY:
        return _METRICS_CONN
    close_metrics_connection()
    METRICS_DB.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(METRICS_DB, timeout=30)
    try:
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA synchronous=NORMAL")
        ensure_metrics_schema(conn)
        conn.commit()
    except Exception:
        conn.close()
        raise
    stat = METRICS_DB.stat()
    _METRICS_CONN = conn
    _METRICS_IDENTITY = (stat.st_dev, stat.st_ino)
    return conn


atexit.register(close_metrics_connection)


def write_metrics(state: dict) -> None:
    if not METRICS_ENABLED:
        return
    timestamp = int(time.time())
    ewma = state.get("ewma", {}) if isinstance(state.get("ewma"), dict) else {}
    last_applied = (
        state.get("last_applied", {}) if isinstance(state.get("last_applied"), dict) else {}
    )
    congestion = state.get("congestion", {}) if isinstance(state.get("congestion"), dict) else {}
    baseline = float(ewma.get("baseline_rtt", DEFAULT_BASELINE_RTT))
    load = float(ewma.get("load_rtt", baseline))
    dl_rate = float(last_applied.get("dl_rate", 0)) / 1_000_000
    ul_rate = float(last_applied.get("ul_rate", 0)) / 1_000_000
    state_value = (
        0.0
        if congestion.get("dl_state") == "GREEN" and congestion.get("ul_state") == "GREEN"
        else 1.0
    )
    rows = [
        (timestamp, WAN_NAME, "wanctl_rate_download_mbps", dl_rate, None, "raw"),
        (timestamp, WAN_NAME, "wanctl_rate_upload_mbps", ul_rate, None, "raw"),
        (timestamp, WAN_NAME, "wanctl_rtt_ms", load, None, "raw"),
        (timestamp, WAN_NAME, "wanctl_rtt_baseline_ms", baseline, None, "raw"),
        (timestamp, WAN_NAME, "wanctl_rtt_delta_ms", max(0.0, load - baseline), None, "raw"),
        (
            timestamp,
            WAN_NAME,
            "wanctl_state",
            state_value,
            json.dumps({"source": "cake-autorate-state-bridge"}, separators=(",", ":")),
            "raw",
        ),
    ]
    # Retry loop for concurrent writes with wanctl@spectrum writer.
    # Uses exponential backoff: 0.1s, 0.2s, 0.4s, 0.8s, 1.6s (max 5 attempts).
    for attempt in range(5):
        try:
            conn = metrics_connection()
            with conn:
                conn.executemany(
                    """
                    INSERT INTO metrics (timestamp, wan_name, metric_name, value, labels, granularity)
                    VALUES (?, ?, ?, ?, ?, ?)
                    """,
                    rows,
                )
            break  # success
        except sqlite3.OperationalError as exc:
            if "locked" in str(exc).lower() and attempt < 4:
                time.sleep(0.1 * (2**attempt))  # exponential backoff
                continue
            close_metrics_connection()
            raise  # non-lock error or max retries exceeded


def status_to_state(status: str) -> str:
    normalized = status.lower()
    if "idle" in normalized or "low" in normalized:
        return "GREEN"
    if "bufferbloat" in normalized or "high" in normalized:
        return "YELLOW"
    return "YELLOW"


def build_state(parsed: tuple[int, int, str, str], green_streak: int) -> tuple[dict, int]:
    parsed_dl_rate_bps, parsed_ul_rate_bps, dl_status, ul_status = parsed
    previous_state = previous_state_snapshot()
    previous_directions = previous_cake_directions(previous_state)
    snapshots = qdisc_snapshots((DL_IF, UL_IF))
    dl_stats, dl_error = snapshots[DL_IF]
    ul_stats, ul_error = snapshots[UL_IF]
    if dl_stats:
        mark_counter_resets(dl_stats, previous_directions.get("download"))
    if ul_stats:
        mark_counter_resets(ul_stats, previous_directions.get("upload"))
    dl_rate_bps = (dl_stats or {}).get("rate_bps") or parsed_dl_rate_bps
    ul_rate_bps = (ul_stats or {}).get("rate_bps") or parsed_ul_rate_bps
    dl_state = status_to_state(dl_status)
    ul_state = status_to_state(ul_status)
    baseline, load, rtt_backend = update_rtt(dl_state, ul_state, previous_state)
    next_green_streak = green_streak + 1 if dl_state == "GREEN" and ul_state == "GREEN" else 0
    return (
        {
            "download": {
                "green_streak": next_green_streak,
                "soft_red_streak": 0,
                "red_streak": 0,
                "current_rate": dl_rate_bps,
            },
            "upload": {
                "green_streak": next_green_streak,
                "soft_red_streak": 0,
                "red_streak": 0,
                "current_rate": ul_rate_bps,
            },
            "ewma": {"baseline_rtt": baseline, "load_rtt": load},
            "measurement": {
                "backend": rtt_backend,
                "source_ip": PING_SOURCE_IP or None,
                "hosts": PING_HOSTS,
            },
            "last_applied": {"dl_rate": dl_rate_bps, "ul_rate": ul_rate_bps},
            "cake_stats": {
                "collected_at": datetime.now().isoformat(),
                "collection_ok": dl_error is None and ul_error is None,
                "errors": {"download": dl_error, "upload": ul_error},
                "directions": {"download": dl_stats, "upload": ul_stats},
            },
            "timestamp": datetime.now().isoformat(),
            "congestion": {"dl_state": dl_state, "ul_state": ul_state},
            "source": "cake-autorate-state-bridge",
        },
        next_green_streak,
    )


def load_state_with_age() -> tuple[dict | None, float | None]:
    try:
        stat = STATE.stat()
        age = max(0.0, time.time() - stat.st_mtime)
        state = json.loads(STATE.read_text(encoding="utf-8"))
        if not isinstance(state, dict):
            return None, age
        return state, age
    except (OSError, json.JSONDecodeError):
        return None, None


def health_payload() -> dict:
    state, age = load_state_with_age()
    if state is None or age is None:
        return {
            "status": "degraded",
            "source": "cake-autorate-state-bridge",
            "wans": [
                {
                    "name": WAN_NAME,
                    "measurement": {
                        "available": False,
                        "raw_rtt_ms": None,
                        "staleness_sec": None,
                        "producer": "cake-autorate-bridge",
                        "backend": None,
                        "source_ip": None,
                    },
                    "irtt": {"available": False},
                }
            ],
        }

    ewma = state.get("ewma") if isinstance(state.get("ewma"), dict) else {}
    measurement = state.get("measurement") if isinstance(state.get("measurement"), dict) else {}
    raw_rtt = ewma.get("load_rtt")
    available = isinstance(raw_rtt, (int, float)) and age <= MAX_STATE_AGE_SECONDS
    last_applied = (
        state.get("last_applied", {}) if isinstance(state.get("last_applied"), dict) else {}
    )
    congestion = state.get("congestion", {}) if isinstance(state.get("congestion"), dict) else {}
    dl_rate = last_applied.get("dl_rate")
    ul_rate = last_applied.get("ul_rate")
    dl_state = congestion.get("dl_state", "?")
    ul_state = congestion.get("ul_state", "?")
    backend = measurement.get("backend")
    source_ip = measurement.get("source_ip")
    return {
        "status": "healthy" if available else "degraded",
        "version": "cake-autorate-trial",
        "uptime_seconds": None,
        "consecutive_failures": 0 if available else 1,
        "source": "cake-autorate-state-bridge",
        "wans": [
            {
                "name": WAN_NAME,
                "measurement": {
                    "available": available,
                    "raw_rtt_ms": float(raw_rtt) if isinstance(raw_rtt, (int, float)) else None,
                    "staleness_sec": age,
                    "producer": "cake-autorate-bridge",
                    "backend": backend if isinstance(backend, str) else None,
                    "source_ip": source_ip if isinstance(source_ip, str) else None,
                },
                "irtt": {"available": False},
                "download": {
                    "state": dl_state,
                    "current_rate_mbps": round(dl_rate / 1_000_000, 3)
                    if isinstance(dl_rate, (int, float))
                    else None,
                    "qdisc_bandwidth": f"{round(dl_rate / 1_000_000):g}Mbit"
                    if isinstance(dl_rate, (int, float))
                    else "?",
                },
                "upload": {
                    "state": ul_state,
                    "current_rate_mbps": round(ul_rate / 1_000_000, 3)
                    if isinstance(ul_rate, (int, float))
                    else None,
                    "qdisc_bandwidth": f"{round(ul_rate / 1_000_000):g}Mbit"
                    if isinstance(ul_rate, (int, float))
                    else "?",
                },
                "congestion": congestion,
                "last_applied": last_applied,
            }
        ],
    }


class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:  # noqa: N802 - stdlib handler API
        if self.path != "/health":
            self.send_error(404)
            return
        body = json.dumps(health_payload(), separators=(",", ":")).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


def start_health_server() -> ThreadingHTTPServer | None:
    if ONESHOT or HEALTH_PORT <= 0:
        return None
    server = ThreadingHTTPServer((HEALTH_HOST, HEALTH_PORT), HealthHandler)
    thread = threading.Thread(target=server.serve_forever, name="health-server", daemon=True)
    thread.start()
    return server


def downsample_raw_to_1m() -> None:
    """Downsample raw metrics older than 1 hour into 1-minute aggregates.

    This replaces the wanctl@ daemon's periodic downsampling, which doesn't run
    when wanctl@ services are inactive (cake-autorate is the rate controller).
    Must run BEFORE cleanup_old_metrics to preserve historical data.
    """
    if not METRICS_ENABLED:
        return
    cutoff = int(time.time()) - 3600  # 1 hour
    try:
        conn = metrics_connection()
        with conn:
            cursor = conn.execute(
                """
                INSERT INTO metrics
                    (timestamp, wan_name, metric_name, value, labels, granularity)
                SELECT timestamp - (timestamp % 60),
                       wan_name,
                       metric_name,
                       AVG(value),
                       '{"downsampled_from":' || COUNT(*) || '}',
                       '1m'
                FROM metrics
                WHERE granularity = 'raw' AND timestamp < ?
                GROUP BY wan_name, metric_name, timestamp - (timestamp % 60)
                """,
                (cutoff,),
            )
            total_created = cursor.rowcount

            # Delete raw data that has been aggregated
            cur = conn.execute(
                "DELETE FROM metrics WHERE granularity='raw' AND timestamp < ?", (cutoff,)
            )
            deleted = cur.rowcount
            conn.commit()

            if total_created > 0 or deleted > 0:
                try:
                    subprocess.run(
                        [
                            "logger",
                            "-t",
                            f"cake-autorate-{WAN_NAME}-bridge",
                            f"downsampling: created {total_created} 1m rows, deleted {deleted} raw rows",
                        ],
                        check=False,
                        timeout=5,
                    )
                except Exception:
                    pass  # non-critical
    except Exception:
        pass  # non-critical; will retry next cycle


def cleanup_old_metrics() -> None:
    """Delete raw metrics older than 1 hour. Runs periodically to prevent DB bloat.

    This replaces the wanctl@ daemon's startup maintenance, which doesn't run
    when wanctl@ services are inactive (cake-autorate is the rate controller).
    Note: downsample_raw_to_1m should be called BEFORE this to preserve data.
    """
    if not METRICS_ENABLED:
        return
    cutoff = int(time.time()) - 3600  # 1 hour
    try:
        with open_metrics_db() as conn:
            conn.execute("PRAGMA journal_mode=WAL")
            cur = conn.execute(
                "DELETE FROM metrics WHERE granularity='raw' AND timestamp < ?", (cutoff,)
            )
            deleted = cur.rowcount
            if deleted > 0:
                # Log cleanup to syslog
                try:
                    subprocess.run(
                        [
                            "logger",
                            "-t",
                            f"cake-autorate-{WAN_NAME}-bridge",
                            f"retention cleanup: deleted {deleted} raw rows older than 1h",
                        ],
                        check=False,
                        timeout=5,
                    )
                except Exception:
                    pass  # non-critical
    except Exception:
        pass  # non-critical; will retry next cycle


def main() -> int:
    start_health_server()
    green_streak = 1
    last_cleanup = 0.0
    cleanup_interval = 900  # 15 minutes (matches wanctl maintenance_interval_seconds)
    while True:
        parsed = latest_parsed_row()
        if parsed:
            state, green_streak = build_state(parsed, green_streak)
            write_state(state)
            write_metrics(state)
        if ONESHOT:
            return 0 if parsed else 1
        now = time.time()
        if now - last_cleanup >= cleanup_interval:
            downsample_raw_to_1m()  # aggregates + deletes in one shot
            last_cleanup = now
        time.sleep(POLL_INTERVAL)


if __name__ == "__main__":
    raise SystemExit(main())
